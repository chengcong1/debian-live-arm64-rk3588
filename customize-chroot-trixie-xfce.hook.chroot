#!/bin/bash

# Runs inside the chroot (config/hooks/live/*.hook.chroot) while building the
# Debian trixie / Xfce live ISO for the Radxa Rock 5B.
#
# Xfce counterpart of customize-chroot-trixie.hook.chroot: same Calamares /
# locale / DTB / sound-card handling, but the display manager is lightdm and
# the input method is wired up for an X11 session.

set -e

# ---------------------------------------------------------------------------
# Installer (Calamares)
# ---------------------------------------------------------------------------
# Debian's calamares-settings-debian is written for amd64: make the bootloader
# module install grub-efi-arm64 on the target and enable the EFI fallback path
# so the installed board still boots when the firmware entry is lost.
if [ -f /usr/sbin/bootloader-config ]; then
	sed -i "s|grub-efi-amd64|grub-efi-arm64|g" /usr/sbin/bootloader-config
	echo "chroot \$CHROOT /usr/bin/ssh-keygen -A" >> /usr/sbin/bootloader-config
fi

if [ -f /etc/calamares/modules/bootloader.conf ]; then
	sed -i "s|installEFIFallback: false|installEFIFallback: true|g" /etc/calamares/modules/bootloader.conf
fi

# live-boot >= 5 mounts the medium under /run/live/medium
sed -i "s|/lib/live/mount/medium|/run/live/medium|g" /etc/calamares/modules/*.conf 2>/dev/null || true

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
# lightdm is the only display manager in this image; Calamares picks the
# installed one from displaymanager.conf by itself.
systemctl enable lightdm.service || true
systemctl enable NetworkManager.service || true
systemctl enable systemd-timesyncd.service || true
systemctl set-default graphical.target || true

# ---------------------------------------------------------------------------
# Locales (English default, Chinese available)
# ---------------------------------------------------------------------------
if [ -f /etc/locale.gen ]; then
	sed -i -e 's/^# *\(en_US.UTF-8\)/\1/' -e 's/^# *\(zh_CN.UTF-8\)/\1/' /etc/locale.gen
	if command -v locale-gen > /dev/null 2>&1; then
		locale-gen
	fi
fi

# ---------------------------------------------------------------------------
# /boot/dtb -> /boot/dtb-<version>-edge-rockchip64
# The GRUB snippets (binary_grub_cfg and /etc/grub.d/10_linux) look for the
# device tree under <bootdir>/dtb/rockchip/, make sure the symlink exists.
# ---------------------------------------------------------------------------
if [ ! -e /boot/dtb ]; then
	DTBDIR="$(ls -d /boot/dtb-* 2> /dev/null | head -n 1 || true)"
	if [ -n "${DTBDIR}" ]; then
		ln -s "$(basename "${DTBDIR}")" /boot/dtb
	fi
fi

# ---------------------------------------------------------------------------
# Rock 5B: give the HDMI/DP/analog sound cards human readable names
# ---------------------------------------------------------------------------
mkdir -p /etc/udev/rules.d
cat > /etc/udev/rules.d/90-naming-audios.rules << 'EOF'
SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-hdmi0-sound", ENV{SOUND_DESCRIPTION}="HDMI0 Audio"
SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-hdmi1-sound", ENV{SOUND_DESCRIPTION}="HDMI1 Audio"
SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-hdmiin-sound", ENV{SOUND_DESCRIPTION}="HDMI-In Audio"
SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-dp0-sound", ENV{SOUND_DESCRIPTION}="DP0 Audio"
SUBSYSTEM=="sound", ENV{ID_PATH}=="platform-es8316-sound", ENV{SOUND_DESCRIPTION}="ES8316 Audio"
EOF

# ---------------------------------------------------------------------------
# Chinese input method (fcitx5) for the X11/Xfce session
#
# Xfce runs as a plain X11 session started by lightdm's /etc/X11/Xsession, so
# the systemd environment.d file alone is not enough: the variables have to be
# exported inside the X session as well. Qt applications additionally need
# QT_IM_MODULE (X11 has no wayland text-input protocol).
# ---------------------------------------------------------------------------
if command -v fcitx5 > /dev/null 2>&1; then
	if command -v im-config > /dev/null 2>&1; then
		im-config -n fcitx5 || true
	fi

	mkdir -p /etc/environment.d
	cat > /etc/environment.d/90-fcitx5.conf << 'EOF'
XMODIFIERS=@im=fcitx
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
EOF

	mkdir -p /etc/X11/Xsession.d
	cat > /etc/X11/Xsession.d/90-fcitx5 << 'EOF'
# Make fcitx5 the input method of the whole X11 session
export XMODIFIERS=@im=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
EOF

	mkdir -p /etc/xdg/autostart
	cat > /etc/xdg/autostart/fcitx5.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Comment=Start the Fcitx 5 input method
Exec=fcitx5 -d
Icon=fcitx
EOF
fi

# ---------------------------------------------------------------------------
# Live session autologin is left to live-config's own 0100-lightdm component,
# which uncomments autologin-user= in /etc/lightdm/lightdm.conf at boot from
# LIVE_USERNAME. Do not add a competing config here: a wrong greeter/session
# name silently breaks autologin and drops to the greeter instead.
# ---------------------------------------------------------------------------
