# ---------------------------------------------------------------------------
# Packages for: Debian trixie + KDE Plasma 6 (full) + Armbian kernel
# Variant WITHOUT the Armbian framework: no armbian-firmware, no armbian-bsp-*,
# no armbian-config. Firmware is Debian's, the kernel is Armbian's.
# Shared by build-edge.yml (edge / 7.x) and build-current.yml (current / 6.18 LTS),
# the list is kernel independent.
# ---------------------------------------------------------------------------

# --- live system base -------------------------------------------------------
live-task-recommended
user-setup
systemd-timesyncd
locales
console-setup
keyboard-configuration
tzdata
sudo
openssh-server
ca-certificates
vim
nano
less
man-db
bash-completion
curl
wget
git
jq
htop
psmisc
lsof
rsync
unzip

# --- disks / filesystems / board tools --------------------------------------
parted
gdisk
fdisk
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
btrfs-progs
f2fs-tools
xfsprogs
mmc-utils
u-boot-tools
device-tree-compiler
gparted
ethtool
i2c-tools
rfkill
iw
wpasupplicant
wireless-regdb
network-manager
net-tools
pciutils
usbutils
hdparm
smartmontools
pv

# --- firmware (Debian, no Armbian firmware) ---------------------------------
#   firmware-misc-nonfree -> arm/mali/arch10.8/mali_csffw.bin   (panthor GPU)
#   firmware-realtek      -> rtw89/rtw8852b_fw-1.bin            (RTL8852BE Wi-Fi)
#                            rtl_bt/rtl8852bu_fw.bin            (Bluetooth)
# live-build additionally installs every other firmware-* package that ships
# /lib/firmware for arm64 (LB_FIRMWARE_CHROOT defaults to true), which is what
# makes Wi-Fi/Bluetooth/GPU work out of the box on this image.
firmware-realtek
firmware-misc-nonfree

# --- live installer ---------------------------------------------------------
calamares-settings-debian
grub-efi-arm64
grub-efi-arm64-bin

